# Configuración segura por defecto: fuente institucional aún no integrada.
NODE_ENV=development
# Acceso sintético sólo desarrollo/test; la UI lo habilita por opt-in explícito.
DEMO_MODE=false
VERIFICATION_PROVIDER=official
DATABASE_URL=postgresql://ruteam:ruteam_demo_local@127.0.0.1:5432/ruteam
TEST_DATABASE_URL=postgresql://ruteam:ruteam_demo_local@127.0.0.1:5432/ruteam_test
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SESSION_TTL_SECONDS=3600
# En el teléfono cambiar localhost por IP LAN del computador y añadir origen LAN arriba.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Opcional. Instancia OSRM de confianza provisionada por el equipo.
# ROUTING_BASE_URL=http://127.0.0.1:5000
