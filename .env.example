# Configuración segura por defecto: fuente institucional aún no integrada.
NODE_ENV=development
# El proveedor sintético sólo se admite fuera de producción.
DEMO_MODE=false
VERIFICATION_PROVIDER=official
DATABASE_URL=postgresql://ruteam:ruteam_demo_local@127.0.0.1:5432/ruteam
TEST_DATABASE_URL=postgresql://ruteam:ruteam_demo_local@127.0.0.1:5432/ruteam_test
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SESSION_TTL_SECONDS=3600
# En el teléfono cambiar localhost por IP LAN del computador y añadir origen LAN arriba.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Opcional. Instancia OSRM de confianza provisionada por el equipo.
# ROUTING_BASE_URL=http://127.0.0.1:5000

# Correo de verificación y recuperación. Requiere SMTP, remitente y URL de la app.
# Genera un secreto aleatorio de al menos 32 caracteres. No se comparte con Expo.
# AUTH_TOKEN_SECRET=
# AUTH_PUBLIC_URL=http://localhost:8081
# MAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=

# Sólo seed de fixtures aislados. Si se omite, no crea ni cambia la contraseña.
# AUTH_FIXTURE_PASSWORD=

# Cartografía configurable. Utiliza instancias aprobadas por el equipo.
# GEOCODING_BASE_URL=http://127.0.0.1:2322
# ROUTING_SELECTION_SECRET= # Opcional. Valor aleatorio de al menos 32 caracteres, compartido entre instancias.
# EXPO_PUBLIC_ROUTE_TILE_URL=https://servidor-aprobado.example/{z}/{x}/{y}.png
# EXPO_PUBLIC_ROUTE_TILE_ATTRIBUTION=Créditos del proveedor cartográfico
