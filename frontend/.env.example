# Sólo configuración pública del cliente; nunca contraseñas o DATABASE_URL.
# La URL debe ser alcanzable desde el navegador/teléfono.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Opcional. Teselas raster XYZ propias o autorizadas y su atribución visible.
# EXPO_PUBLIC_ROUTE_TILE_URL=https://tiles.example.invalid/{z}/{x}/{y}.png
# EXPO_PUBLIC_ROUTE_TILE_ATTRIBUTION="Datos cartográficos del proveedor configurado"

# Push nativo opcional. Usa el UUID del proyecto Expo autorizado por el equipo.
# EXPO_PUBLIC_EAS_PROJECT_ID=
# RUTEAM_ANDROID_PACKAGE=org.ruteam.demo
# RUTEAM_IOS_BUNDLE_IDENTIFIER=org.ruteam.demo
# RUTEAM_ANDROID_GOOGLE_SERVICES_FILE=/ruta/local/google-services.json
